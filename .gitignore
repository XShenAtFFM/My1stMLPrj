# ====================================================================
# 1. SYSTEM & GLOBAL JUNK
# ====================================================================
.DS_Store
.env
.idea/
.bash_profile
__pycache__/
*.py[cod]
*$py.class

# ====================================================================
# 2. THE "PRODUCTIVE CODE ONLY" LOGIC (Recursive)
# ====================================================================
# Ignore everything inside any subdirectory by default
*/*

# Allow back the directories themselves (so Git can look inside)
!*/
!**/

# Allow back ONLY your productive source/config files
!**/*.py
!**/*.ipynb
!**/*.yaml
!**/*.json
!**/*.toml
!**/README.md

# ====================================================================
# 3. OVERRIDE: ABSOLUTE IGNORES (Last Word Wins)
# ====================================================================
# These stay ignored even if they contain a .py or .yaml file inside.
**/lightning_logs/
**/cifar_log/
**/*_logs/
**/.ipynb_checkpoints/
**/mlruns/
**/outputs/
Image Classification Training Pipeline/cifar-10-batches-py/
RAG/chunks/
RAG/documents/
NoCommit/
SelfTeaching/CNN/dataset/
SelfTeaching/SideSlipAgWiPytorch/DataSets/
.idea/
TransferLearning/cifar-10-batches-py/
TransferLearning/resnettransfer_log/
TransformerFromScratch/tinyshakespeare_log/
